{
  "name": "weduutec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "mock": "tsx scripts/mock-platform.ts",
    "register": "tsx --env-file-if-exists=.env scripts/register.ts",
    "burst": "tsx --env-file-if-exists=.env scripts/burst.ts",
    "status": "tsx --env-file-if-exists=.env scripts/status.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "bullmq": "^6.3.11",
    "fastify": "^5.4.0",
    "ioredis": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.3"
  }
}
